---
import Layout from "@layouts/Layout.astro"
import Button from "@components/Button.astro"
---

<Layout title="Serverfehler">
    <section >
        <h1 class="typo-xl-fat">500</h1>
        <p class="typo-24" >Es ist ein Fehler aufgetreten. Bitte versuche es später erneut.</p>
        <Button href="/">Zurück zur Startseite</Button>
    </section>
</Layout>


<style>

    section {
        height: 80vh;

        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: var(--spacing-s);
    }
</style>
