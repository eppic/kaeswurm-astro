---

import { Image } from 'astro:assets';

import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Ticker from "@components/Ticker.astro";
import { langPaths, getLang } from '@i18n/paths';

import img_hero from "@public/img/astrid/hero.webp";

import img_astrid from "@public/img/astrid-portrait.webp";
import img_mauritius from "@public/img/astrid/mauritius.webp";
import img_weltrekord from "@public/img/ausb/hero.webp";
import img_facebook from "@public/img/astrid/thumbnail.webp";

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);

const content = {
	de: {
		ticker: [
			"Tanz bedeutet für mich pure Lebensfreude und Ausdruck.",
			"Ich liebe es, Menschen durch Bewegung zu verbinden.",
			"Musik zu hören, zu fühlen und in Tanz umzusetzen ist einfach toll.",
			"Tanz bedeutet für mich pure Lebensfreude und Ausdruck.",
			"Ich liebe es, Menschen durch Bewegung zu verbinden.",
			"Musik zu hören, zu fühlen und in Tanz umzusetzen ist einfach toll."
		],
		hero: "Über mich",
		title: "Hey, ich bin Astrid!",
		intro: "Begeisterte Tänzerin, Trainerin und Autorin im Bereich Line Dance. Seit meinem ersten Schritt auf dem Parkett trage ich Leidenschaft für Bewegung und Gemeinschaft im Herzen und ich darf andere Menschen dabei begleiten, ihren eigenen Groove zu finden.",
		journeyTitle: "Mein Weg in Bewegung",
		journey: "Meine Tanzreise begann in den späten 1980er Jahren mit der klassischen Tanzschule in Bad Neuenahr-Ahrweiler -Formation, Standard/Latein inklusive Tanzsportabzeichen Bronze bis Gold. 1996 entdeckte ich schließlich den Line Dance in Frankfurt am Main - ein Moment, der alles veränderte. Von 2007 bis 2011 folgte die Ausbildung zur Line Dance Trainerin (Examen NTA) und die Tätigkeit als NTA-Direktorin in Deutschland. 2010 erwarb ich die Lizenz als diplomierte Tanztrainerin für Country- und Westerntanz in Österreich. Seit 2012 leite ich den Tanzsportclub TSC Blau-Gold Bad Reichenhall. Darüber hinaus bilde ich unabhängig davon angehende Line-Dance-TrainerInnen aus, basierend auf meinem Buch „Von Anchor Step bis Weave“.",
		worldRecord: "Weltrekord aufgestellt",
		viral: "Virales Video",
		driveTitle: "Was mich antreibt",
		drive: "Ich bin überzeugt: Tanzen ist mehr als Schritte - es verbindet Menschen, schafft Freude und stärkt das Selbstvertrauen. Mit meinem Konzept möchte ich eine Umgebung schaffen, in der Jede und Jeder mit Spaß lernen kann. Mein Ansatz: Technik trifft Leichtigkeit vom Anchor Step bis zum Weave, klar strukturiert, herzlich und inklusiv.",
		personalTitle: "Ein kleiner persönlicher Einblick",
		personal: "Wenn ich nicht auf der Tanzfläche bin, genieße ich die Natur rund um Bad Reichenhall, lese gerne kreative Fachbücher oder lasse mich von Musikrichtungen inspirieren, die jenseits des Mainstreams liegen. Ich reise außerdem sehr gerne, entdecke neue Länder und Kulturen und freue mich besonders, wenn ich auf diesen Reisen auch tanzen und lehren darf. Tanzen heißt für mich: <span>„Offen sein für Neues, für Menschen, für das Leben.“</span>",
	},
	en: {
		ticker: [
			"Dance means pure joy of life and expression to me.",
			"I love connecting people through movement.",
			"Listening to music, feeling it, and expressing it through dance is simply amazing.",
			"Dance means pure joy of life and expression to me.",
			"I love connecting people through movement.",
			"Listening to music, feeling it, and expressing it through dance is simply amazing."
		],
		hero: "About me",
		title: "Hey, I'm Astrid!",
		intro: "I’m a passionate dancer, trainer, and author in the field of line dance. Since my very first step onto the dance floor, I’ve carried a deep passion for movement and community, and I love supporting others in finding their own groove.",
		journeyTitle: "My Journey in Motion",
		journey: "My dance journey began in the late 1980s with classical dance training in Bad Neuenahr-Ahrweiler, including formation dancing and ballroom/Latin styles, earning dance sport badges from bronze to gold. In 1996, I discovered line dance in Frankfurt am Main – a moment that changed everything. <br> From 2007 to 2011, I completed my training as a line dance instructor (NTA certification) and worked as NTA director in Germany. In 2010, I obtained my license as a certified dance trainer for country and western dance in Austria. Since 2012, I have been leading the dance sports club TSC Blau-Gold Bad Reichenhall. In addition, I train independent aspiring line dance instructors based on my book ‘From Anchor Step to Weave’.",
		worldRecord: "World record achieved",
		viral: "Viral Video",
		driveTitle: "What keeps me going",
		drive: "I truly believe that dance is more than just steps – it connects people, creates joy, and builds self-confidence. With my concept, I aim to create an environment where everyone can learn with joy. My approach: technique meets ease, from anchor step to weave, clearly structured, warm-hearted, and inclusive.",
		personalTitle: "A small personal insight",
		personal: "When I’m not on the dance floor, I enjoy nature around Bad Reichenhall, love reading creative professional literature, or find inspiration in music beyond the mainstream. I also enjoy traveling, discovering new countries and cultures, and I especially appreciate being able to dance and teach while traveling. For me, dancing means: <span>“Being open to new things, to people, to life.”</span>",
	},
};
const t = content[lang];

---

<Layout lang={lang}>
    <main>
        <Hero img={img_hero} text={t.hero} textWidth="10rem" credits="Zell-am-See-Kaprun_JOE" position="50% 13%"/>

        <Ticker ticker={t.ticker} speed="60s"/>

        <div id="content">

            <section class="section_def aboutme fade-up">
                <div>
                    <div><Image src={img_astrid} alt="Portrait of Astrid"></div>
                    <div>
                        <h2 class="typo-36">{t.title}</h2>
                        <p class="gray">{t.intro}</p>
                    </div>
                </div>
                <hr>

                <div>
                    <h3 class="typo-24">{t.journeyTitle}</h3>
                    <p class="gray" set:html={t.journey} />
                </div>
            </section>

            <section class="section_def">
                <div class="events">
                    <div>
                        <div class="img-box"><Image src={img_mauritius} alt="Line dancing on the beach"></div>
                        <div class="events-title">
                            <h3 class="typo-24">Mauritius Workshop</h3>
                            <p class="gray">2024</p>
                        </div>
                    </div>
                    <div>
                        <div class="img-box"><Image src={img_weltrekord} alt="Cheesy at an award ceremony"></div>
                        <div class="events-title">
                            <h3 class="typo-24">{t.worldRecord}</h3>
                            <p class="gray">2025</p>
                        </div>
                    </div>
                    <div onclick="window.open('https://www.facebook.com/share/v/1HRWN2FCg7/', '_blank', 'noopener,noreferrer'); return false;">
                        <div class="img-box"><Image src={img_facebook} alt="A huge group of people line dancing"></div>
                        <div class="events-title">
                            <h3 class="typo-24">{t.viral}</h3>
                        </div>
                    </div>
                </div>
            </section>

            <section class="section_def more fade-up-stagger">
                <div class="stagger">
                    <h3 class="typo-24">{t.driveTitle}</h3>
                    <p class="gray">{t.drive}</p>
                </div>
                <div class="stagger">
                    <h3 class="typo-24">{t.personalTitle}</h3>
                    <p class="gray" set:html={t.personal} />
                </div>
            </section>
        </div>
    </main>
</Layout>

<style>
    .aboutme {

        display: flex;
        flex-direction: column;

        hr {
            margin-top: var(--spacing-s);
            margin-bottom: var(--spacing-l);
            color: #ffffff;
        }
        
        & div:first-child {
            display: flex;
            gap: var(--spacing-l);
            align-items: center;

            & div:last-child {
                display: flex;
                flex-direction: column;
                gap: var(--spacing-m);

                max-width: 30rem;
            }

            img {
                border-radius: var(--spacing-s);
                object-fit: cover;

                max-height: 26rem;
                width: 40rem;
            }
        }

        & div:last-child {
            h3 {
                margin-bottom: var(--spacing-m);
            }
        }
        
    }

    .events {
        display: flex;
        gap: var(--spacing-l);


        & > div:first-child, & > div:nth-child(2) {
            width: 33%;
        }

        & > div:last-child {
            width: 20%;
            cursor: pointer;
        }

        .events-title{
            padding-top: var(--spacing-m);
            display: flex;
            justify-content: space-between;
        }

        .img-box {
            height: 20rem;
        }

        img {
            object-fit: cover;
            object-position: center;
            height: 100%;

            border-radius: var(--spacing-s);
        }
    }

    .more {
        display: flex;
        gap: var(--spacing-m);

        & > div {
            width: 50%;
            h3 {
                padding-bottom: var(--spacing-s);
                
            }
        }

        span {
            font-weight: 600;
        }

        margin-bottom: 5rem;
    }

    @media (max-width: 1079px) {
        
        .aboutme {
            margin-top: var(--spacing-l);

            & div:first-child {
                flex-direction: column;
                gap: var(--spacing-m);
            }

            h2 {
                font-size: 1.75rem;
            }

            h3 {
                margin-bottom: var(--spacing-s) !important;
            }
        }

    }

    @media (max-width: 599px) {

        .events {
            flex-direction: column;
            align-items: center;

            & > div:first-child, & > div:nth-child(2) {
                width: 100%;
            }


            & > div:last-child {
                width: 33%;                
            }


            & > div {
                max-width: fit-content;
            }

            .img-box {
                height: 14rem;
                max-width: fit-content;
            }

            margin-bottom: var(--spacing-l);
        }

        .more {
            flex-direction: column;

            & > div {
                width: 100%;
            }
        }
    }

    


</style>