---
import { Image } from 'astro:assets';

import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Ticker from "@components/Ticker.astro";
import MailSection from "@components/MailSection.astro";
import { langPaths, getLang } from '@i18n/paths';
import { site, mailto } from '@config/site';

import img_hero from "@public/img/ausb/hero.webp";

import anmeldeformular from "@public/Anmeldung-Trainer-Ausbildung-2027.pdf"

import alm_1 from "@public/img/ausb/alm/alm_1.webp";
import alm_2 from "@public/img/ausb/alm/alm_2.webp";
import alm_3 from "@public/img/ausb/alm/alm_3.webp";
import alm_4 from "@public/img/ausb/alm/alm_4.webp";
import alm_5 from "@public/img/ausb/alm/alm_5.webp";
import alm_6 from "@public/img/ausb/alm/alm_6.webp";

import gal_1 from "@public/img/ausb/gal/gal_1.webp";
import gal_2 from "@public/img/ausb/gal/gal_2.webp";
import gal_3 from "@public/img/ausb/gal/gal_3.webp";
import gal_4 from "@public/img/ausb/gal/gal_4.webp";
import gal_5 from "@public/img/ausb/gal/gal_5.webp";

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);

const content = {
    de: {
        meta: {
            title: "Ausbildung",
            description: "Line-Dance-Trainer*innen-Ausbildung nach Astrid Kaeswurm: praxisnah, strukturiert und mit Zertifikat, auf der Neubichler Alm.",
        },
        ticker: [
            "Für die Termine in 2027 sind im Frühling und im Herbst noch freie Plätze verfügbar.",
            "Bereits 99 Trainer haben Ihre Prüfung zu zertifizierten Trainern absolviert!",
            "Für die Termine in 2027 sind im Frühling und im Herbst noch freie Plätze verfügbar.",
            "Bereits 99 Trainer haben Ihre Prüfung zu zertifizierten Trainern absolviert!"
        ],
        hero: "Ausbildung",
        datesTitle: "Unsere nächsten Termine:",
        datesTitleMobile: "Unsere nächsten <br>Termine:",
        dates: [
            "Frühlingskurs: 13. - 14. März + 10. - 11. April 2027",
            "Herbstkurs: 09. - 10. Oktober + 30. - 31. Oktober 2027",
        ],
        datesNote: "Die Ausbildung findet an den genannten Wochenenden statt.",
        warningAlt: "Warnungssymbol",
        title: "Line-Dance-Trainer*innen-Ausbildung",
        byline: "nach Astrid Kaeswurm",
        summary: `Eine zeitgemäße Ausbildung für alle, die Line Dance professioneller unterrichten möchten - praxisnah, strukturiert und stilübergreifend (Country, Modern & Mixed). Der Lehrgang wurde von einer Line-Dance-Trainerin für Line Dancer entwickelt und orientiert sich an den Erfahrungen aus dem Unterricht mit ganz unterschiedlichen Gruppen.
                    <br> Du erhältst fundierte didaktische und methodische Impulse, die dich dabei unterstützen, Gruppen sicher anzuleiten und deinen Unterricht abwechslungsreich zu gestalten. Neben Technik, Musikalität und Choreografie stehen auch Unterrichtsaufbau, Kommunikation und der Umgang mit verschiedenen Leistungsniveaus im Fokus.`,
        skillsTitle: "Das lernst du",
        skills: [
            [
                {
                    icon: "compass", alt: "Kompass", title: "Didaktik & Unterricht",
                    body: `<ul>
                        <li>Zielgruppen definieren und sinnvoll ansprechen</li>
                        <li>Aufbau moderner Line-Dance-Unterrichtseinheiten</li>
                        <li>Raumorientierung, Flächennutzung und Anpassung von Choreografien</li>
                        <li>Auswahl und Analyse geeigneter Musik & Tänze</li>
                    </ul>`,
                },
                {
                    icon: "clock", alt: "Uhr", title: "Ablauf & Umfang",
                    body: `<ul>
                        <li><span>24 Stunden</span> Gesamtumfang (32 Lerneinheiten inkl. Praxis- & Übungsstunden)</li>
                        <li>Durchführung an zwei aufeinander aufbauenden Wochenenden</li>
                        <li>Die Wochenenden sind <span>nicht</span> einzeln buchbar</li>
                    </ul>`,
                },
            ],
            [
                {
                    icon: "gears", alt: "Zahnräder", title: "Technik & Körperarbeit",
                    body: `<ul>
                        <li>Grundhaltung und saubere Bewegung</li>
                        <li>Fußpositionen und Gewichtsverlagerung</li>
                        <li>Passende Tänze für unterschiedliche Levels</li>
                    </ul>`,
                },
                {
                    icon: "pen", alt: "Stift", title: "Prüfung & Abschluss",
                    body: `<p>Die Ausbildung schließt mit einer dreiteiligen Prüfung ab:</p>
                    <ul>
                        <li><span>schriftlich</span></li>
                        <li><span>mündlich</span></li>
                        <li><span>praktische Lehrprobe (Kolloquium)</span></li>
                    </ul>
                    <p>Nach erfolgreichem Abschluss erhältst du ein Zertifikat. Regelmäßige Weiterbildung wird empfohlen.</p>`,
                },
            ],
            [
                {
                    icon: "check", alt: "Haken", title: "Praxis",
                    body: `<ul>
                        <li>Schrittfolgen, Tanzarten und Variationen</li>
                        <li>Anwendung des Gelernten im realen Unterrichtssetting</li>
                    </ul>`,
                },
                {
                    icon: "euro", alt: "Euro-Zeichen", title: "Kosten",
                    body: `<p>Die Kursgebühr beträgt <span>400 €</span>.</p>
                    <p>Hinzu kommen <span>50 € Prüfgebühren</span>, falls der Teilnehmer an der Prüfung teilnehmen möchte.</p>
                    <p>Die Entscheidung zur Prüfung kann am Tag der Prüfung getroffen werden; die Gebühr fällt nur dann an.</p>
                    <p><span>Insgesamt würden somit 450 € anfallen.</span></p>
                    <p>In den Kursgebühren enthalten sind:</p>
                    <ul>
                        <li>Alle Unterrichtsmaterialien</li>
                        <li>Das Line-Dance-Buch</li>
                        <li>Getränke während der Schulung</li>
                    </ul>`,
                },
            ],
        ],
        faqTitle: "Häufig gestellte<br>Fragen",
        faq: [
            {
                icon: "circle", alt: "Kreis",
                q: "Brauche ich Vorkenntnisse oder Tanzerfahrung?",
                a: "Grundlegende Line-Dance-Erfahrung ist von Vorteil, aber keine formale Ausbildung oder Trainerlizenz ist erforderlich. Die Inhalte sind so aufgebaut, dass sowohl ambitionierte Tänzer:innen als auch bereits unterrichtende Personen davon profitieren.",
            },
            {
                icon: "hash", alt: "Raute",
                q: "Ab welchem Alter kann ich an der Ausbildung teilnehmen?",
                a: "Die Line-Dance-Trainer*innen-Ausbildung richtet sich an Teilnehmer:innen ab 18 Jahren. Voraussetzung ist die Freude am Tanzen und der Wunsch, Line Dance professioneller unterrichten zu können - unabhängig vom bisherigen Werdegang.",
            },
            {
                icon: "triangle", alt: "Dreieck",
                q: "Ist die Ausbildung offiziell anerkannt?",
                a: "Die Ausbildung basiert auf dem Fachbuch „Von Anchor Step bis Weave“ von Astrid Kaeswurm. <br> Die Ausbildung wird von offiziellen Sportverbänden nicht anerkannt. Sie vermittelt jedoch praxisnahe Kompetenzen, die Trainer*innen von Line-Dance-Gruppen kennen sollten.",
            },
        ],
        galleryTitle: "Blicke hinter die Kulissen der Ausbildung",
        galleryText: "Hier siehst du viele Eindrücke aus den Ausbildungen der letzten Jahre: von den ersten Schritten in der Praxis bis zu besonderen Momenten hinter den Kulissen. ",
        galleryAlts: ["Leute die eine Konferenz halten", "Ein Mann vor einem Laptop", "Klubtreffen in einem großen Raum", "Gruppenfoto", "Line Dancing im Klubraum"],
        almAlts: ["Berg in der Nacht", "Wiese mit Zaun", "Ausblick mit Bänken", "Ausblick mit sichtbarem Glockenturm", "Berg am Tag", "Klubraum"],
        almText: "Für unsere Ausbildung habe ich die idyllische Neubichler Alm im Salzburger Land ausgewählt - ein Ort, der Ruhe, Natur und Inspiration vereint. Hier kannst du dich ganz auf den Unterricht konzentrieren, in den Pausen wandern, durchatmen oder einfach die atemberaubende Bergkulisse genießen. Abends wird gemeinsam gegessen, getanzt und gelacht - denn Line Dance verbindet!",
        almLink: "auf Karte anzeigen",
        mailSubject: "Ausbildung",
        mailButton: "Jetzt schreiben",
        form: "Anmeldeformular",
    },
    en: {
        meta: {
            title: "Certification",
            description: "Line Dance Trainer Certification by Astrid Kaeswurm: hands-on, structured and with a certificate, held at the Neubichler Alm.",
        },
        ticker: [
            "There are still free spots available for the sessions in 2027 in spring and autumn.",
            "99 trainers have already passed their exam and become certified trainers!",
            "There are still free spots available for the sessions in 2027 in spring and autumn.",
            "99 trainers have already passed their exam and become certified trainers!"
        ],
        hero: "Certification",
        datesTitle: "Our next dates:",
        datesTitleMobile: "Our next <br>dates:",
        dates: [
            "Spring course: March 13. - 14. + April 10. - 11. 2027",
            "Autumn course: October 9. - 10. + October 30. - 31. 2027",
        ],
        datesNote: "The training takes place on the weekends listed above.",
        warningAlt: "Warning Sign",
        title: "Line Dance Trainer Certification",
        byline: "by Astrid Kaeswurm",
        summary: "A modern training program for anyone who wants to teach line dance professionally – hands-on, structured, and style-spanning (country, modern & mixed). This certification was developed by a line dance trainer for line dancers and is based on extensive teaching experience with a wide range of groups. <br> You will gain solid didactic and methodological skills that help you confidently guide groups and design engaging classes. In addition to technique, musicality, and choreography, the program focuses on lesson structure, communication, and working with different skill levels.",
        skillsTitle: "What you will learn",
        skills: [
            [
                {
                    icon: "compass", alt: "Compass", title: "Didactics & Teaching",
                    body: `<ul>
                        <li>Defining target groups and addressing them effectively</li>
                        <li>Designing modern line dance lesson units</li>
                        <li>Space orientation, area usage, and adapting choreographies</li>
                        <li>Selecting and analyzing suitable music & dances</li>
                    </ul>`,
                },
                {
                    icon: "clock", alt: "Clock", title: "Schedule & Duration",
                    body: `<ul>
                        <li>Total training duration: <span>24 hours</span> (32 learning units including practice and exercise sessions)</li>
                        <li>Conducted over two consecutive weekends</li>
                        <li>The weekends are <span>not</span> individually bookable</li>
                    </ul>`,
                },
            ],
            [
                {
                    icon: "gears", alt: "Gears", title: "Technique & Body Work",
                    body: `<ul>
                        <li>Basic stance and clean movement</li>
                        <li>Foot positions and weight transfer</li>
                        <li>Appropriate dances for different skill levels</li>
                    </ul>`,
                },
                {
                    icon: "pen", alt: "Pen", title: "Examination & Certification",
                    body: `<p>The training concludes with a three-part examination:</p>
                    <ul>
                        <li><span>Written</span></li>
                        <li><span>Oral</span></li>
                        <li><span>Practical teaching demonstration (colloquium)</span></li>
                    </ul>
                    <p>Upon successful completion, you will receive a certificate. Regular continuing education is recommended.</p>`,
                },
            ],
            [
                {
                    icon: "check", alt: "Checkmark", title: "Practice",
                    body: `<ul>
                        <li>Step sequences, dance styles and variations</li>
                        <li>Application of learned concepts in a real classroom setting</li>
                    </ul>`,
                },
                {
                    icon: "euro", alt: "Euro Sign", title: "Costs",
                    body: `<p>The course fee is <span>€400</span>.</p>
                    <p>An additional <span>€50 examination fee</span> applies if the participant wishes to take part in the exam.</p>
                    <p>The decision to participate in the exam can be made on the day of the exam; the fee only applies then.</p>
                    <p><span>In total, this would amount to €450.</span></p>
                    <p>The course fee includes:</p>
                    <ul>
                        <li>All instructional materials</li>
                        <li>The line dance book</li>
                        <li>Beverages during the training</li>
                    </ul>`,
                },
            ],
        ],
        faqTitle: "Commonly asked <br>Questions",
        faq: [
            {
                icon: "circle", alt: "Circle",
                q: "Do I need prior knowledge or dance experience?",
                a: "Basic line dance experience is an advantage, but no formal training or instructor license is required. The content is designed in a way that both aspiring trainers and those who already teach can benefit from the program.",
            },
            {
                icon: "hash", alt: "Hash",
                q: "From what age can I participate in the training?",
                a: "The Line Dance Trainer Certification is open to participants aged 18 and over. The main requirements are a passion for dancing and the desire to teach line dance professionally – regardless of previous career background.",
            },
            {
                icon: "triangle", alt: "Triangle",
                q: "Is the training officially recognized?",
                a: "The training is a private qualification based on Astrid Kaeswurm’s book “From Anchor Step to Weave” and is not officially recognized by sports associations. However, it provides practical, hands-on skills that are essential for teaching line dance professionally.",
            },
        ],
        galleryTitle: "Behind the Scenes of the Training",
        galleryText: "Here you can see many impressions from the training programs of recent years: from the first practical steps to special moments behind the scenes. Some certified trainers have even gone on to be booked as line dance instructors on cruise ships after completing their training.",
        galleryAlts: ["People holding a conference", "A man in front of a laptop", "Club meeting in a large room", "Group photo", "Line dancing in a club room"],
        almAlts: ["Mountain at night", "Meadow with a fence", "View with benches", "View with a visible bell tower", "Mountain during the day", "Club room"],
        almText: "For our training, I chose the idyllic Neubichler Alm in the Salzburg region – a place of calm, nature, and inspiration. Here, you can fully focus on the training, go hiking during breaks, take a deep breath, or simply enjoy the breathtaking mountain scenery. In the evenings, we eat together, dance, and laugh – because line dance connects people!",
        almLink: "View on map",
        mailSubject: "Certification",
        mailButton: "Contact me now",
        form: "Open registration form",
    },
};
const t = content[lang];

const gallery = [gal_1, gal_2, gal_3, gal_4, gal_5].map((src, i) => ({ src, alt: t.galleryAlts[i], class: `gal_${i + 1}` }));
const alm = [alm_1, alm_2, alm_3, alm_4, alm_5, alm_6];
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
    <main>
        <Hero img={img_hero} text={t.hero} credits="Zell-am-See-Kaprun_JOE" position="50% 35%">
            <div class="disclaimer">
                <h2 class="desktop typo-24">{t.datesTitle}</h2>
                <h2 class="mobile typo-24" set:html={t.datesTitleMobile} />
                <ul>
                    {t.dates.map((d) => <li>{d}</li>)}
                </ul>
                <p><span>{t.datesNote}</span></p>
                <img src="/svg/warning.svg" alt={t.warningAlt}>
            </div>
        </Hero>

        <Ticker color={'var(--kw-green)'} ticker={t.ticker} speed="40s"/>

        <div id="content">

            <section class="summary section_def">
                <h2 class="typo-36">{t.title}</h2>
                <p class="gray">{t.byline}</p>

                <p class="gray" set:html={t.summary} />
            </section>

            <section class="skills section_def">

                <h2 class="typo-36">{t.skillsTitle}</h2>

                <div class="skills-container fade-up-stagger">
                    {t.skills.map((column) => (
                        <div>
                            {column.map((skill) => (
                                <div class="skills-item stagger">
                                    <div>
                                        <img src={`/svg/icons-125/${skill.icon}.svg`} alt={skill.alt}>
                                        <h3 class="typo-24">{skill.title}</h3>
                                    </div>
                                    <div class="gray" set:html={skill.body} />
                                </div>
                            ))}
                        </div>
                    ))}
                </div>
            </section>

            <section class="faq section_def fade-up-stagger">
                <h2 class="typo-36" set:html={t.faqTitle} />

                <div>
                    {t.faq.map((item) => (
                        <div class="faq-item stagger">
                            <h3 class="typo-24"><img src={`/svg/${item.icon}.svg`} alt={item.alt}>{item.q}</h3>
                            <p class="gray" set:html={item.a} />
                        </div>
                    ))}
                </div>
            </section>

            <section class="gallery section_def">
                <h2 class="typo-36">{t.galleryTitle}</h2>
                <p>{t.galleryText}</p>

            </section>

            <div class="gallery-scroll">
                <div>
                    {[...gallery, ...gallery].map((img) => <Image class={img.class} src={img.src} alt={img.alt}/>)}
                </div>
            </div>


            <section class="alm-wrapper">
                <div class="alm">
                    <div class="carousel">
                        <div class="slider">
                            {alm.map((src, i) => <Image src={src} alt={t.almAlts[i]} />)}
                        </div>

                        <button class="prev">&#10094;</button>
                        <button class="next">&#10095;</button>

                        <div class="slider-nav"></div>
                    </div>

                    <div>
                        <h2 class="typo-36">Neubichler Alm</h2>
                        <p>{t.almText}</p>
                        <a href="https://maps.app.goo.gl/wjtHTf9QJ4hUsYaN8" target="_blank" rel="noopener noreferrer">{t.almLink}</a>
                    </div>
                </div>
            </section>

            <MailSection lang={lang} href={mailto(site.email, t.mailSubject)}>
                {t.mailButton}
                <a style="text-decoration: underline;" href={anmeldeformular} target="_blank" >{t.form}</a>
            </MailSection>

        </div>


    </main>
</Layout>



<style>

    .disclaimer {
        color: var(--base-white);
        background-color: var(--kw-green2);
        padding: var(--spacing-m);
        padding-bottom: var(--spacing-l);
        border-radius: var(--spacing-s);

        display: flex;
        flex-direction: column;
        gap: var(--spacing-s);

        position: relative;
        width: fit-content;

        ul {
            list-style-type: disc;
            list-style-position: inside;
            margin-left: var(--spacing-s);
        }

        span {
            font-weight: 600;
        }

        img {
            position: absolute;
            width: 2.75rem;
            right: var(--spacing-m);
            top: calc(var(--spacing-m) *0.75);
        }

    }

    .summary {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-s);
    }

    .skills {

        h2 {
            margin-bottom: var(--spacing-m);
        }

        .skills-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-gap: var(--spacing-m);

            & > div {
                display: flex;
                flex-direction: column;
                gap: var(--spacing-m);
            }
        }

        .skills-item {
            background-color: var(--base-white);
            border-radius: var(--spacing-s);
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            padding: var(--spacing-m);

            & div:first-child {
                display: flex;
                align-items: center;
                gap: var(--spacing-s);

                img {
                    width: 2rem;

                }

                margin-bottom: var(--spacing-m);
            }

            & div:last-child {
                ul {
                    list-style: disc;
                    list-style-position: inside;
                    margin-left: calc(var(--spacing-s)*0.5);
                }

                span {
                    font-weight: 600;
                }

                display: flex;
                flex-direction: column;
                gap: var(--spacing-s);
            }

        }
    }

    .faq {
        display: flex;
        gap: var(--spacing-xl);

        h2 {
            min-width: fit-content;
            line-height: 120%;
        }

        & > div {
            display: flex;
            flex-direction: column;
            gap: var(--spacing-s);
        }

        .faq-item {
            background-color: var(--kw-green-light);
            border-radius: var(--spacing-s);
            padding: calc(var(--spacing-m) * 0.75);

            h3 {
                display: flex;
                gap: var(--spacing-s);
                margin-bottom: var(--spacing-s);
            }
        }

    }

    .gallery {

        display: flex;
        flex-direction: column;
        gap: var(--spacing-m);
        margin-bottom: var(--spacing-l);
    }

    .gallery-scroll {
        overflow: hidden;
        width: 100%;
        white-space: nowrap;
        position: relative;
        padding-bottom: 6rem;

        & > div {
            display: flex;
            width: max-content;
            animation: scroll 40s linear infinite;
            gap: var(--spacing-m);
            will-change: transform;
            height: 27rem;

            img {
                border-radius: var(--spacing-m);
                object-fit: cover;
                height: 100%;
                width: 40rem;
            }

            @media (max-width: 900px) {
                
                height: 13rem;

                img {
                    width: 20rem;
                }
            }
        }
    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50.2%);
        }
    }

    .alm-wrapper {
        background-color: var(--base-black);
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .alm {
        max-width: 1200px;
        
        background-color: var(--base-black);
        color: var(--base-white);
        display: flex;

        .carousel {
        position: relative;
        width: 100%;
        max-width: 800px;
        margin: auto;
        overflow: hidden;
        }

        .slider {
        display: flex;
        transition: transform 0.5s ease-in-out;

        display: flex;
        transition: transform 0.5s ease-in-out;
        touch-action: pan-y;
        }


        .slider img {
        width: 100%;
        flex-shrink: 0;
        object-fit: cover;
        }

        /* Pfeile */
        .prev, .next {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        color: var(--kw-yellow);
        border: none;
        padding: 0.5rem 1rem;
        cursor: pointer;
        font-size: 1.5rem;
        z-index: 10;
        }

        .prev { left: 10px; }
        .next { right: 10px; }

        /* Dots */
        .slider-nav {
        display: flex;
        justify-content: center;
        gap: 0.75rem;
        position: absolute;
        bottom: 15px;
        left: 50%;
        transform: translateX(-50%);
        }

        .slider-nav button {
        width: 1rem;
        height: 1rem;
        border-radius: 50%;
        border: none;
        background: var(--base-white);
        cursor: pointer;
        }

        .slider-nav button.active {
        background: var(--kw-yellow);
        }

     
        & > div:last-child {
            flex: 0 0 36%;

            padding-left: var(--spacing-l);
            padding-right: var(--spacing-m);

            display: flex;
            flex-direction: column;
            justify-content: center;
            gap: var(--spacing-s);

            h2 {
                color: var(--kw-yellow);
            }

            a {
                color: var(--kw-yellow);
                text-align: end;
                text-decoration: underline;
                padding-right: var(--spacing-m);
            }
        }
    }

    @media (max-width: 900px) {
        .skills {
            
            .skills-container {
                display: flex;
                flex-direction: column;

            }
        }
    }
    
    @media (max-width: 945px) {
        .faq {
            flex-direction: column;
            gap: var(--spacing-l);
        }

        .alm-wrapper {

            .alm {

                .slider-wrapper {
                    flex: unset;
                }
                
                & > div:last-child {
                    flex: unset;

                    padding: var(--spacing-m);
                }
                flex-direction: column;

                .carousel .slider img {
                    max-height: 24rem;
                }
            }
        }
    }

    @media (max-width: 450px) {
        .mobile {
            display: block;
        }

        .desktop {
            display: none;
        }
    }

    @media (max-width: 345px) {
        .disclaimer {

            padding: var(--spacing-s);
        
            img {
                display: none;
            }
        }
    }

    

</style>


<script is:inline>
  const slider = document.querySelector(".slider");
  const slides = document.querySelectorAll(".slider img");
  const prevBtn = document.querySelector(".prev");
  const nextBtn = document.querySelector(".next");
  const nav = document.querySelector(".slider-nav");

  let current = 0;
  let startX = 0;
  let isDragging = false;
  const autoplayDelay = 4000;

  // -----------------------
  // DOTS ERZEUGEN
  // -----------------------
  slides.forEach((_, index) => {
    const dot = document.createElement("button");
    if (index === 0) dot.classList.add("active");

    dot.addEventListener("click", () => {
      current = index;
      updateSlider();
      resetAutoplay();
    });

    nav.appendChild(dot);
  });

  const dots = document.querySelectorAll(".slider-nav button");

  function updateSlider() {
    slider.style.transform = `translateX(-${current * 100}%)`;

    dots.forEach(dot => dot.classList.remove("active"));
    dots[current].classList.add("active");
  }

  function nextSlide() {
    current = (current + 1) % slides.length;
    updateSlider();
  }

  function prevSlide() {
    current = (current - 1 + slides.length) % slides.length;
    updateSlider();
  }

  nextBtn.addEventListener("click", () => {
    nextSlide();
    resetAutoplay();
  });

  prevBtn.addEventListener("click", () => {
    prevSlide();
    resetAutoplay();
  });

  // -----------------------
  // AUTOPLAY
  // -----------------------
  let autoplay = setInterval(nextSlide, autoplayDelay);

  function resetAutoplay() {
    clearInterval(autoplay);
    autoplay = setInterval(nextSlide, autoplayDelay);
  }

  // -----------------------
  // MOBILE SWIPE
  // -----------------------
  slider.addEventListener("touchstart", (e) => {
    startX = e.touches[0].clientX;
    isDragging = true;
  });

  slider.addEventListener("touchend", (e) => {
    if (!isDragging) return;

    const endX = e.changedTouches[0].clientX;
    const diff = startX - endX;

    if (diff > 50) {
      nextSlide();
    } else if (diff < -50) {
      prevSlide();
    }

    resetAutoplay();
    isDragging = false;
  });
</script>
