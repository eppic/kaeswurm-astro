export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);

const content = {
    de: {
        hero: "Kurse",
        ticker: [
            "Lerne die neuesten Choreografien mit Astrid Kaeswurm",
            "Mehr erfahren & buchen",
            "Kurse, Workshops & Veranstaltungen",
            "Lerne die neuesten Choreografien mit Astrid Kaeswurm",
