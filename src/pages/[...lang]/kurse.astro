---
import { Image } from 'astro:assets';
import Layout from "@layouts/Layout.astro";
import Hero from "@components/Hero.astro";
import Ticker from "@components/Ticker.astro";
import MailSection from '@components/MailSection.astro';
import KurseItem from '@components/KurseItem.astro';
import { langPaths, getLang, tr } from '@i18n/paths';
import { today, isPast, formatDates } from '@i18n/dates';
import { useTranslations } from '@i18n/ui';
import { regular, single, type Kurs, type Veranstaltung } from '@data/termine';

import img_hero from "@public/img/kurse/hero.webp";

import gal1 from "@public/img/kurse/img1.webp";
import gal2 from "@public/img/kurse/img2.webp";
import gal3 from "@public/img/kurse/img3.webp";
import gal4 from "@public/img/kurse/img4.webp";
import gal5 from "@public/img/kurse/img5.webp";
import gal6 from "@public/img/kurse/img6.webp";
import gal7 from "@public/img/kurse/img7.webp";

export const getStaticPaths = langPaths;
const lang = getLang(Astro.params.lang);

const content = {
    de: {
        meta: {
            title: "Kurse",
            description: "Line Dance Kurse, Workshops und Veranstaltungen mit Astrid „Cheesy“ Kaeswurm in Piding, Salzburg und Umgebung.",
        },
        hero: "Kurse",
        ticker: [
            "Lerne die neuesten Choreografien mit Astrid Kaeswurm",
            "Mehr erfahren & buchen",
            "Kurse, Workshops & Veranstaltungen",
            "Lerne die neuesten Choreografien mit Astrid Kaeswurm",
            "Mehr erfahren & buchen",
            "Kurse, Workshops & Veranstaltungen",
        ],
        quoteAlt: "Astrid, die ein Mikrofon hält",
        quoteRole: "Tänzerin, Trainerin und Autorin im Bereich Line Dance",
        quote: "Die Anmeldung sowie weitere Informationen erhältst du ganz einfach per E-Mail (siehe unten).<br>Ich freue mich, von dir zu hören!",
        title: "Termine & Kurse Line Dance 2026 & 2027",
        titleMobile: "Termine 2026/2027",
        regular: "Regelmäßige Kurse:",
        single: "Einzelveranstaltungen & Workshops",
        galleryTitle: "Unsere Line Dance Stunden - Sei dabei!",
        galleryText: "Werde Teil unserer Tanz-Community und erlebe Line Dance live!<br>Egal ob Anfänger oder Fortgeschritten - wir freuen uns auf dich und deine Moves.",
        mailSubject: "Kurse",
        mailButton: "Jetzt schreiben",
    },
    en: {
        meta: {
            title: "Courses",
            description: "Line dance classes, workshops and events with Astrid “Cheesy” Kaeswurm in Piding, Salzburg and the surrounding area.",
        },
        hero: "Courses",
        ticker: [
            "Secure your spot",
            "Learn the latest choreographies with Astrid Kaeswurm",
            "Learn more & book",
            "Learn the latest choreographies",
            "Secure your spot",
            "Learn the latest choreographies with Astrid Kaeswurm",
            "Learn more & book",
            "Learn the latest choreographies",
        ],
        quoteAlt: "Astrid holding a microphone",
        quoteRole: "Dancer, trainer, and author in the field of line dance.",
        quote: "Registration and further information are available via email (see below). I’m looking forward to hearing from you!",
        title: "Line Dance Dates & Classes 2026/2027",
        titleMobile: "Classes 2026/2027",
        regular: "Regular Courses:",
        single: "Single Events & Workshops",
        galleryTitle: "Our Line Dance Classes - Be Part of It!",
        galleryText: "Join our dance community and experience live line dance!<br>Whether beginner or advanced – we’re excited to welcome you and your moves.",
        mailSubject: "Courses",
        mailButton: "Contact me",
    },
};
const t = content[lang];

const now = today();

const regularVisible = regular.filter((k) => !k.hidden && (!k.end || k.end >= now));

const singleVisible = single
    .map((v) => ({ ...v, dates: v.dates.filter((d) => !isPast(d, now)) }))
    .filter((v) => v.dates.length > 0)
    .sort((a, b) => a.dates[0].start.localeCompare(b.dates[0].start));

function dateText(v: Veranstaltung) {
    const dates = formatDates(v.dates, lang);
    if (!v.time) return dates;
    const each = v.dates.length > 1 ? `${useTranslations(lang)("kurse.each")} ` : "";
    return `${dates}, ${each}${tr(v.time, lang)}`;
}

function itemProps(k: Kurs | Veranstaltung) {
    return {
        lang,
        open: k.open,
        title: tr(k.title, lang),
        country: k.country,
        date: "dates" in k ? dateText(k) : tr(k.date, lang),
        address: k.address,
        linkName: k.linkName,
        linkRef: k.linkRef,
        linkDescription: k.linkDescription && tr(k.linkDescription, lang),
    };
}

const gallery = [
    { src: gal1, alt: "Woman Dancing" },
    { src: gal2, alt: "Group Photo in a row" },
    { src: gal3, alt: "Two people dancing" },
    { src: gal4, alt: "Woman" },
    { src: gal5, alt: "People dancing in the club room" },
    { src: gal6, alt: "Big group photo" },
    { src: gal7, alt: "People line dancing" },
];
---

<Layout lang={lang} title={t.meta.title} description={t.meta.description}>
    <main>
        <div class="desktop">
            <Hero img={img_hero} text={t.hero} credits="Tristan Schnitzler" position="30% 30%" height="45rem" />
        </div>
        <div class="mobile">
            <Hero img={img_hero} text={t.hero} credits="Tristan Schnitzler" position="48% 35%"  height="17rem" />
        </div>
        <Ticker ticker={t.ticker} />

    <div id="content">

        <section class="quote-container section_def">
            <div class="quote">
                <div>
                    <div><img src="/img/astrid-mic.webp" alt={t.quoteAlt}></div>
                    <div>
                        <p style="font-weight: 600;">Astrid Kaeswurm</p>
                        <p class="gray">{t.quoteRole}</p>
                    </div>
                    <img class="quote-icon" src="/svg/quote.svg" alt="Quote Icon" width="48px" height="32px">
                </div>
                <p set:html={t.quote} />
            </div>
        </section>

        <section class="section_def termine fade-up" id="Termine">
            <h2 class="desktop typo-36">{t.title}</h2>
            <h2 class="mobile typo-36">{t.titleMobile}</h2>

            <h3 class="typo-24">{t.regular}</h3>

            {regularVisible.map((k) => k.details
                ? <KurseItem {...itemProps(k)}><Fragment set:html={tr(k.details, lang)} /></KurseItem>
                : <KurseItem {...itemProps(k)} />
            )}

            <h3 class="typo-24">{t.single}</h3>

            {singleVisible.map((k) => k.details
                ? <KurseItem {...itemProps(k)}><Fragment set:html={tr(k.details, lang)} /></KurseItem>
                : <KurseItem {...itemProps(k)} />
            )}

        </section>

        <section class="section_def gallery">
            <h2 class="typo-36">{t.galleryTitle}</h2>
            <p class="gray" set:html={t.galleryText} />
        </section>

        <div class="gallery-scroll">
            <div>
                {[...gallery, ...gallery].map((img) => <Image src={img.src} alt={img.alt} />)}
            </div>
        </div>

        <MailSection lang={lang} href={`mailto:astrid@kaeswurm.de?subject=${t.mailSubject}`}>
            {t.mailButton}
        </MailSection>

    </div>

    </main>
</Layout>



<style>

    .quote-container {
        display: flex;
        justify-content: center;
    }

    .quote {
        background-color: var(--base-white);
        border-radius: var(--spacing-s);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
        padding: var(--spacing-m);
        max-width: 55rem;


        display: flex;
        flex-direction: column;
        gap: var(--spacing-s);
        

        & > div {
            display: flex;
            gap: var(--spacing-s);

            & > div:first-child {
                width: 3rem;
                min-width: 3rem;
                height: 3rem;
                overflow: hidden;
                border-radius: 0.8rem;

                img {
                    object-fit: cover;
                    object-position: center;
                }
            }

            & img:last-child {
                margin-left: auto;
            }
        }

    }

    .termine {
        display: flex;
        flex-direction: column;

        h2, h3 {
            margin: var(--spacing-m) var(--spacing-s);
        }

    }

    .gallery {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-m);

        h2, h3 {
            margin: var(--spacing-m) var(--spacing-s);
        }

    }


    .gallery-scroll {
        overflow: hidden;
        width: 100%;
        white-space: nowrap;
        position: relative;
        padding: 4rem 0;

        & > div {
            display: flex;
            width: max-content;
            animation: scroll 50s linear infinite;
            gap: var(--spacing-m);
            will-change: transform;
            height: 27rem;
            
            img {
                border-radius: var(--spacing-m);
                object-fit: cover;
                height: 100%;
                width: 40rem
            }

            @media (max-width: 900px) {
                
                height: 13rem;

                img {
                    width: 20rem;
                }
            }
        }
    }

    @media (max-width: 730px) {

        .mobile {
            display: block;
        }

        .desktop {
            display: none;
        }

    }

    @keyframes scroll {
        0% {
            transform: translateX(0);
        }
        100% {
            transform: translateX(-50.2%);
        }
    }

    @media (max-width: 640px) {
        .quote-icon {
            display: none;
        }

        .quote {
            padding: var(--spacing-s)
        }


    }
</style>