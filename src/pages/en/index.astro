---

import { Image } from 'astro:assets';

import Layout from '@layouts/Layout.astro';
import Hero from '@components/Hero.astro';
import Ticker from '@components/Ticker.astro';
import Button from '@components/Button.astro';

import img_hero from "@public/img/home/hero.webp"
import img_vision from "@public/img/home/vision.webp"
import img_kurse from "@public/img/home/kurse.webp"
import img_buch from "@public/img/home/buch.webp"


const ticker = [
	"Dance means pure joy of life and expression to me.",
	"I love connecting people through movement.",
	"Listening to music, feeling it, and expressing it through dance is simply amazing.",
	"Dance means pure joy of life and expression to me.",
	"I love connecting people through movement.",
	"Listening to music, feeling it, and expressing it through dance is simply amazing."
]

---

<Layout lang="en">
<main>
	<Hero img={img_hero} text="Learning Line Dance with Cheesy is easy!" home credits="Sascha Klahn">
		<Button href="kurse">Current Classes</Button>
	</Hero>
	
	<Ticker ticker={ticker} speed="60s"/>
	<div id="content">
		<section class="home-section">
			<div class="img-box img-1">
				<h2 class="typo-xl-fat">Vision</h2>
				<Image src={img_vision} alt="Cheesy holding her hands up" />
				<p class="credits">© Sascha Klahn</p>
			</div>
			<div class="info-box">
				<h3 class="typo-36">This is me!</h3>
				<p class="info">I’m Cheesy – curious, open, and full of passion for music and dance. When music lifts my mood, it turns into movement, expression, and a pure zest for life. I want to share this joy of line dance with people who are ready to discover something new and experience the energy of music together.</p>
				<Button href="astrid">Read more</Button>
			</div>
		</section>
		<section class="home-section">
			<div class="img-box img-2">
				<h2 class="typo-xl-fat">Classes</h2>
				<Image src={img_kurse} alt="Cheesy at a course" />
				<div class="overlay-gray" />
				<p class="credits">© Tristan Schnitzler</p>
			</div>
			<div class="info-box">
				<h3 class="typo-36">My Classes</h3>
				<p class="info">Line dance combines music, movement, and community. In my classes, adults of all ages come together who enjoy dancing and love to move. Here you’ll find balance, joy, and people with whom dancing simply feels good.</p>
				<Button href="kurse">Read more</Button>
			</div>
		</section>
		<section class="home-section order-change">
			<div class="img-box img-3">
				<h2 class="typo-xl-fat">Book</h2>
				<Image src={img_buch} alt="Line-Dance-Book" />
				<div class="overlay-gray" />
			</div>
			<div class="info-box">
				<h3 class="typo-36">Knowledge that keeps you moving</h3>
				<p class="info">Sometimes a class just isn’t enough – that’s why I’ve gathered my knowledge, experience, and many tips in my own book. And for anyone who likes a little fresh breeze while dancing: my fans are also available here.</p>
				<Button href="shop">Discover now</Button>
			</div>
		</section>
		<section class="quote">
			<div class="quote-line" />
			<div>
				<h2 class="typo-36">
					„We don’t make mistakes – we dance variations!”
				</h2>
				<p><span>Astrid Kaeswurm, </span> dancer, trainer, and author</p>
			</div>
		</section>
	</div>
</main>
</Layout>



<style>
	.info {
		color: var(--base-gray);
	}

	.typo-xl-fat {
		color: var(--base-white);
	}

	.home-section {
		display: grid;
		grid-template-columns: 1fr 1fr;
		height: 40rem;

	}

	.img-box {

		position: relative;
		overflow: hidden;
        user-select: none;  

		img {
			position: absolute;
			z-index: -1;
			top: 0;

			width: 100%;
			height: 100%;
			object-fit: cover; 
			object-position: center;
		}

		h2 {
			margin: var(--spacing-m)
		}

		.overlay-gray {
			position: absolute;
    		background: #3a393950;

			height: 100%;
			width: 100%;

			z-index: -1;
			top: 0;
			left: 0;
		}
	}

	.order-change .info-box { /* Change Container Order */
		grid-row: 1;
	}

	.info-box {
		display: flex;
		flex-direction: column;
		justify-content: center;
		gap: var(--spacing-m);

		margin: var(--spacing-xl);

	}

	.quote {
		background-color: var(--kw-green);
		display: flex;
		gap: var(--spacing-m);
		padding: var(--spacing-xl);
		width: 100%;

		& > div:last-child {
			display: flex;
			flex-direction: column;
			gap: var(--spacing-m);
		}

		span {
			font-weight: 600;
		}

		* {
			color: var(--base-white);
		}
	}

	.quote-line {
		background: var(--base-white);
		align-self: stretch;
		min-width: 3px;
	}

	@media (max-width: 849px) {
		.home-section {
			grid-template-columns: 1fr;
			grid-template-rows: 28rem ;
			height: unset;
		}

		.img-box h2 {
			margin: var(--spacing-s);
		}

		.order-change .info-box {
			grid-row: unset;
		}

		.quote {
			padding: var(--spacing-l) var(--spacing-m);
		}
	}

	@media (max-width: 439px) {
		.info-box {
			margin: var(--spacing-m) var(--spacing-s);
		}
	}

	/* Font Size Scaling */

	@media (max-width: 610px) {
		.typo-xl-fat, .typo-xl-slim {
			font-size: 6rem !important;
		}
	}


	@media (max-width: 499px) {
		.typo-xl-fat, .typo-xl-slim {
			font-size: 4rem !important;
		}
	}


</style>
