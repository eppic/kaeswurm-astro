---
import type { Lang } from "@i18n/paths";
import { Image } from "astro:assets";
import Button from "./Button.astro";
import { useTranslations } from "@i18n/ui";

interface Props {
    lang?: Lang;
    image: ImageMetadata;
    badge?: string;
    name: string;
    details?: string;
    price: number;
    orderHref: string;
    sampleHref?: string;
    soldOut?: string;
}

const { lang = "de", image, badge, name, details, price, orderHref, sampleHref, soldOut } = Astro.props;
const t = useTranslations(lang);

const formattedPrice = new Intl.NumberFormat(lang === "en" ? "en-US" : "de-DE", { style: "currency", currency: "EUR" }).format(price);
---

<article class:list={["card", { "sold-out": soldOut }]}>
    <div class="card-image">
        {badge && <span class="badge">{badge}</span>}
        <Image src={image} alt={name} widths={[300, 400]} sizes="18rem" />
    </div>

    <div class="card-body">
        <h3 class="name">{name}</h3>
        {details && <p class="details">{details}</p>}

        <p class="price">
            <span class="typo-24">{formattedPrice}</span>
            <span class="shipping">{t("shop.shipping")}</span>
        </p>

        {soldOut ? (
            <div class="actions">
                <span class="disabled" aria-disabled="true">{t("shop.soldOut")}</span>
            </div>
            <p class="sold-out-note">{soldOut}</p>
        ) : (
            <div class="actions">
                <Button href={orderHref}>{t("shop.order")}</Button>
                {sampleHref && <a class="sample" href={sampleHref} target="_blank" rel="noopener noreferrer">{t("shop.sample")}</a>}
            </div>
        )}
    </div>
</article>

<style>
    .card {
        display: flex;
        flex-direction: column;
        background-color: var(--base-white);
        border-radius: var(--spacing-s);
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.15);
        overflow: hidden;
    }

    .card-image {
        position: relative;
        height: 18rem;
        padding: var(--spacing-m);
        background-color: var(--kw-red-l2);

        img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }
    }

    .badge {
        position: absolute;
        top: var(--spacing-s);
        right: var(--spacing-s);
        padding: 0.3rem 0.7rem;
        border-radius: 0.8rem;
        background-color: var(--kw-red);
        color: var(--base-white);
        font-size: 0.9rem;
        font-weight: 600;
    }

    .card-body {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding: var(--spacing-m);
    }

    .name {
        font-size: 1.25rem;
        font-weight: 600;
        line-height: 130%;
    }

    .details {
        color: var(--base-gray);
    }

    .price {
        margin-top: auto;
        padding-top: var(--spacing-s);
        display: flex;
        align-items: baseline;
        gap: 0.5rem;

        span:first-child {
            font-weight: 600;
        }
    }

    .shipping {
        font-size: 0.9rem;
        color: var(--base-gray);
    }

    .actions {
        display: flex;
        align-items: center;
        gap: var(--spacing-s);
        margin-top: var(--spacing-s);
    }

    .sample {
        text-decoration: underline;
    }

    .sold-out .card-image img {
        filter: grayscale(1);
        opacity: 0.5;
    }

    .sold-out .card-image {
        background-color: #e6e6e6;
    }

    .sold-out .badge {
        background-color: var(--base-gray);
    }

    .disabled {
        display: inline-flex;
        padding: 0.8rem 1.6rem;
        border-radius: 0.8rem;
        background-color: #d4d4d4;
        color: var(--base-gray);
        font-size: 1.125rem;
        letter-spacing: -0.06em;
        font-stretch: expanded;
        cursor: not-allowed;
    }

    .sold-out-note {
        font-size: 0.9rem;
        color: var(--kw-red);
        font-weight: 600;
    }
</style>
